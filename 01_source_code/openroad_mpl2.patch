+    line = "  ORIGIN 0 0 ;\n"
+           "  SYMMETRY X Y ;";
+    write_lef<<line<<std::endl;
+    std::pair<float,float> shape = id_shape_map_[cluster->getId()];
+    line = "  SIZE "+std::to_string(std::floor(shape.first))+" BY "+std::to_string(std::floor(shape.second))+" ;";
+    write_lef<<line<<std::endl;
+
+    // 写pin
