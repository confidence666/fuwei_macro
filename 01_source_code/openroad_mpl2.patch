+  std::string lef_name = "/root_cluster_"+block_->getName()+".lef";
+  std::string lef_path = path + lef_name;
+
+  std::string start = "VERSION 5.6 ;\n"
+                      "BUSBITCHARS \"[]\" ;\n"
+                      "DIVIDERCHAR \"/\" ;\n";
