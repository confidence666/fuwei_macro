+    // write_lef<<pin<<std::endl;
+    line = "  OBS\n"
+           "      LAYER metal3 ;\n"
+           "        RECT 0 0 100 100 ;\n"
+           "  END\n";
+    write_lef<<line;
+    line = "END fake_macro"+std::to_string(write_order)+"\n";
+    write_order++;
+    write_lef<<line<<std::endl;
+  }
+
+  write_lef.close();
+  // 后面macro_only.lef中DoubleHeightSite及后续的部分暂时不写
+}
